<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CloudX Hub | Dashboard</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />
  <style>
    body {
      min-height: 100vh;
      background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);
    }

    .dashboard-card {
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 1rem;
      box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .dashboard-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 1.25rem 2.5rem rgba(15, 23, 42, 0.1);
    }
  </style>
</head>
<body>
  <!-- Top navigation bar for authenticated users. -->
  <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold text-primary" href="/dashboard">CloudX Hub</a>
      <div class="ms-auto">
        <a class="btn btn-outline-danger" href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <!-- Main dashboard content for the signed-in user. -->
  <main class="container py-5">
    <div class="row align-items-center mb-4">
      <div class="col-lg-8">
        <h1 class="display-6 fw-bold mb-2">Welcome, <%= user && user.fullName ? user.fullName : 'User' %></h1>
        <p class="text-secondary mb-0">Here is your CloudX Hub workspace overview.</p>
      </div>
      <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <a href="/logout" class="btn btn-danger btn-lg">Logout</a>
      </div>
    </div>

    <!-- Dashboard feature cards for primary user actions. -->
    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card bg-white p-4 h-100">
          <h2 class="h5 fw-semibold">My Projects</h2>
          <p class="text-secondary mb-0">Review and organize your active project repositories.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card bg-white p-4 h-100">
          <h2 class="h5 fw-semibold">Upload Files</h2>
          <p class="text-secondary mb-0">Add secure files and assets to your cloud workspace.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card bg-white p-4 h-100">
          <h2 class="h5 fw-semibold">Recent Activity</h2>
          <p class="text-secondary mb-0">Track the latest actions and updates in your account.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="dashboard-card bg-white p-4 h-100">
          <h2 class="h5 fw-semibold">Account</h2>
          <p class="text-secondary mb-0">Manage your profile and session settings.</p>
        </div>
      </div>
    </div>
  </main>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>
</body>
</html>
