<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CloudX Hub | Dashboard</title>


<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">


<link
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
rel="stylesheet">


<link
rel="stylesheet"
href="/css/style.css">

</head>


<body>


<!-- Navigation -->

<nav class="navbar navbar-expand-lg sticky-top">

<div class="container">


<a class="navbar-brand" href="/dashboard">

<i class="bi bi-cloud-fill me-2"></i>

CloudX Hub

</a>



<div class="d-flex align-items-center">


<a
href="/projects"
class="btn btn-primary me-2">

<i class="bi bi-folder2-open me-1"></i>

Projects

</a>


<a
href="/logout"
class="btn btn-outline-danger">

<i class="bi bi-box-arrow-right me-1"></i>

Logout

</a>


</div>


</div>

</nav>




<main class="container py-5">


<!-- Welcome -->

<div class="mb-5">


<h1 class="fw-bold">

Welcome,
<%= user.fullName %>

</h1>


<p class="text-muted">

Manage your secure cloud workspace, projects and files.

</p>


</div>





<!-- Statistics -->


<div class="row g-4 mb-4">



<div class="col-md-6">


<div class="dashboard-card p-4">


<div class="d-flex justify-content-between align-items-center">


<div>

<h6 class="text-muted">

Total Projects

</h6>


<div class="stat-number">

<%= totalProjects %>

</div>


</div>


<div class="stat-icon">

<i class="bi bi-folder-fill"></i>

</div>


</div>


</div>


</div>





<div class="col-md-6">


<div class="dashboard-card p-4">


<div class="d-flex justify-content-between align-items-center">


<div>

<h6 class="text-muted">

Total Files

</h6>


<div class="stat-number">

<%= totalFiles %>

</div>


</div>


<div class="stat-icon">

<i class="bi bi-file-earmark-lock-fill"></i>

</div>


</div>


</div>


</div>



</div>







<div class="row g-4">



<!-- Left Side -->


<div class="col-lg-8">



<!-- Recent Projects -->


<div class="section-card p-4 mb-4">


<div class="d-flex justify-content-between align-items-center mb-3">


<h4 class="mb-0">

<i class="bi bi-clock-history me-2"></i>

Recent Projects

</h4>


<a
href="/projects"
class="btn btn-sm btn-primary">

View All

</a>


</div>




<% if(recentProjects.length === 0){ %>


<div class="text-center text-muted py-4">

<i class="bi bi-folder-x fs-1"></i>

<p class="mt-2">

No projects created yet.

</p>


</div>



<% } else { %>



<div class="list-group">


<% recentProjects.forEach(project => { %>



<div class="list-group-item border-0 mb-2 rounded">


<div class="d-flex justify-content-between">


<div>


<strong>

<i class="bi bi-folder me-2"></i>

<%= project.project_name %>

</strong>


<br>


<small class="text-muted">

Created:

<%= new Date(project.created_at).toLocaleString() %>

</small>


</div>


</div>


</div>



<% }) %>


</div>



<% } %>



</div>








<!-- Activity -->


<div class="section-card p-4">


<h4 class="mb-4">

<i class="bi bi-shield-check me-2"></i>

Security Activity

</h4>




<% if(recentActivities.length === 0){ %>


<p class="text-muted">

No security activity recorded.

</p>



<% } else { %>


<div>


<% recentActivities.forEach(activity => { %>


<div class="activity-item">


<div class="activity-icon">


<i class="bi bi-check-circle-fill"></i>


</div>



<div>


<strong>

<%= activity.action %>

</strong>


<br>


<small class="text-muted">

IP:
<%= activity.ip_address || "Unknown" %>

|

<%= new Date(activity.created_at).toLocaleString() %>


</small>


</div>


</div>



<% }) %>


</div>



<% } %>



</div>



</div>







<!-- Right Side -->


<div class="col-lg-4">





<!-- Quick Actions -->


<div class="section-card p-4 mb-4">


<h4>

<i class="bi bi-lightning-fill me-2"></i>

Quick Actions

</h4>



<div class="d-grid gap-3 mt-3">


<a
href="/projects"
class="btn btn-primary">

<i class="bi bi-folder-plus me-2"></i>

Manage Projects

</a>



</div>


</div>








<!-- Security Status -->


<div class="section-card p-4">


<h4>

<i class="bi bi-shield-lock-fill me-2"></i>

Security Status

</h4>



<div class="mt-3">


<div class="security-badge mb-2">

<i class="bi bi-check-circle-fill me-2"></i>

IAM Access Control Enabled

</div>


<br>


<div class="security-badge mb-2">

<i class="bi bi-check-circle-fill me-2"></i>

S3 Secure Storage

</div>


<br>


<div class="security-badge mb-2">

<i class="bi bi-check-circle-fill me-2"></i>

Activity Monitoring

</div>


<br>


<div class="security-badge">

<i class="bi bi-check-circle-fill me-2"></i>

Cloud Security Controls Active

</div>


</div>


</div>





</div>


</div>



</main>



</body>

</html>
