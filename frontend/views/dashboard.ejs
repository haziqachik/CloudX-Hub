<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CloudX Hub | Dashboard</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <style>
    body{
      background:#f4f7fb;
    }

    .dashboard-card{
      border:none;
      border-radius:16px;
      box-shadow:0 8px 25px rgba(0,0,0,.08);
      transition:.2s;
    }

    .dashboard-card:hover{
      transform:translateY(-4px);
    }

    .stat-number{
      font-size:2rem;
      font-weight:bold;
      color:#0d6efd;
    }

    .section-card{
      border:none;
      border-radius:16px;
      box-shadow:0 8px 25px rgba(0,0,0,.08);
    }
  </style>

</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">

<div class="container">

<a class="navbar-brand fw-bold" href="/dashboard">
CloudX Hub
</a>

<div>

<a href="/dashboard" class="btn btn-outline-light me-2">
Dashboard
</a>

<a href="/projects" class="btn btn-light me-2">
Projects
</a>

<a href="/logout" class="btn btn-danger">
Logout
</a>

</div>

</div>

</nav>


<div class="container mt-5">


<div class="mb-5">

<h2>
Welcome,
<%= user.fullName %>
</h2>

<p class="text-muted">
Manage your secure cloud projects and files.
</p>

</div>



<div class="row g-4">


<div class="col-md-6">

<div class="dashboard-card p-4">

<h5>Total Projects</h5>

<div class="stat-number">
<%= totalProjects %>
</div>

</div>

</div>


<div class="col-md-6">

<div class="dashboard-card p-4">

<h5>Total Files</h5>

<div class="stat-number">
<%= totalFiles %>
</div>

</div>

</div>


</div>



<div class="row mt-4">


<div class="col-lg-8">


<div class="section-card p-4 mb-4">


<h4>
Recent Projects
</h4>


<% if(recentProjects.length===0){ %>

<p class="text-muted">
No projects yet.
</p>


<% }else{ %>


<ul class="list-group">


<% recentProjects.forEach(project=>{ %>


<li class="list-group-item">

<strong>
<%= project.project_name %>
</strong>

<br>

<small class="text-muted">

Created

<%= new Date(project.created_at).toLocaleString() %>

</small>

</li>


<% }) %>


</ul>


<% } %>


</div>



<!-- Recent Activity Section -->
<div class="section-card p-4">


<h4>
Recent Activity
</h4>


<% if(recentActivities.length===0){ %>

<p class="text-muted">
No activity recorded yet.
</p>


<% } else { %>


<div class="table-responsive">

<table class="table table-hover">

<thead>

<tr>

<th>
Action
</th>

<th>
IP Address
</th>

<th>
Time
</th>

</tr>

</thead>


<tbody>


<% recentActivities.forEach(activity=>{ %>


<tr>

<td>

<strong>
<%= activity.action %>
</strong>

</td>


<td>
<%= activity.ip_address || "Unknown" %>
</td>


<td>

<%= new Date(activity.created_at).toLocaleString() %>

</td>


</tr>


<% }) %>


</tbody>

</table>

</div>


<% } %>


</div>


</div>




<div class="col-lg-4">


<div class="section-card p-4">


<h4>
Quick Actions
</h4>


<div class="d-grid gap-3 mt-3">


<a
href="/projects"
class="btn btn-primary">

Manage Projects

</a>


<a
href="/projects"
class="btn btn-success">

Upload Files

</a>


<a
href="/logout"
class="btn btn-outline-danger">

Logout

</a>


</div>


</div>


</div>


</div>


</div>


</body>
</html>
