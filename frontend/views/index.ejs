<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CloudX Hub | Secure Project Repository</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />
  <style>
    :root {
      --cloudx-primary: #0b3d91;
      --cloudx-accent: #1f8ef1;
      --cloudx-slate: #f5f7fb;
      --cloudx-dark: #0f172a;
    }

    body {
      background: linear-gradient(180deg, #ffffff 0%, var(--cloudx-slate) 100%);
      color: var(--cloudx-dark);
    }

    .hero {
      padding: 5rem 0 4rem;
      background: radial-gradient(circle at top right, rgba(31, 142, 241, 0.2), transparent 50%);
    }

    .feature-card {
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 1rem;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 1rem 2rem rgba(11, 61, 145, 0.12);
    }

    footer {
      border-top: 1px solid rgba(15, 23, 42, 0.08);
      background-color: #ffffff;
    }
  </style>
</head>
<body>
  <!-- Responsive navigation bar for primary site navigation -->
  <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold text-primary" href="/">CloudX Hub</a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mainNavbar"
        aria-controls="mainNavbar"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavbar">
        <div class="ms-auto d-flex gap-2 mt-3 mt-lg-0">
          <a class="btn btn-outline-primary" href="/login">Login</a>
          <a class="btn btn-primary" href="/register">Register</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero section that introduces CloudX Hub and core actions -->
  <header class="hero">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-lg-7">
          <h1 class="display-5 fw-bold mb-3">Secure cloud repository for modern teams</h1>
          <p class="lead text-secondary mb-4">
            CloudX Hub helps you store, organize, and protect project assets with enterprise-grade security controls.
          </p>
          <div class="d-flex flex-wrap gap-2">
            <a href="/login" class="btn btn-primary btn-lg">Login</a>
            <a href="/register" class="btn btn-outline-primary btn-lg">Register</a>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="p-4 bg-white rounded-4 shadow-sm border">
            <h2 class="h5 fw-semibold mb-3">Why CloudX Hub</h2>
            <p class="mb-0 text-secondary">
              Built with Node.js, Express, EJS, and Bootstrap 5 to deliver a fast, secure, and scalable repository platform.
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Feature section highlighting the platform security pillars -->
  <main class="pb-5">
    <div class="container">
      <div class="row g-4">
        <div class="col-md-4">
          <article class="feature-card h-100 p-4 bg-white">
            <h3 class="h5 fw-semibold">Secure File Storage</h3>
            <p class="text-secondary mb-0">
              Store project files in a protected cloud environment with reliable access and version-ready architecture.
            </p>
          </article>
        </div>
        <div class="col-md-4">
          <article class="feature-card h-100 p-4 bg-white">
            <h3 class="h5 fw-semibold">AWS IAM Access Control</h3>
            <p class="text-secondary mb-0">
              Enforce strict identity and permission management using role-based policies for every user and action.
            </p>
          </article>
        </div>
        <div class="col-md-4">
          <article class="feature-card h-100 p-4 bg-white">
            <h3 class="h5 fw-semibold">AWS KMS Encryption</h3>
            <p class="text-secondary mb-0">
              Protect sensitive data at rest and in transit with managed cryptographic keys and centralized auditability.
            </p>
          </article>
        </div>
      </div>
    </div>
  </main>

  <!-- Professional footer with product copyright text -->
  <footer class="py-4">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
      <p class="mb-0 text-secondary">&copy; <%= new Date().getFullYear() %> CloudX Hub. All rights reserved.</p>
      <p class="mb-0 text-secondary">Secure Cloud Project Repository</p>
    </div>
  </footer>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>
</body>
</html>
