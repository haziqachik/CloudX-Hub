<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CloudX Hub | Login</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
    crossorigin="anonymous"
  />
  <style>
    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #f8fbff 0%, #eaf2ff 100%);
      display: flex;
      align-items: center;
    }

    .auth-card {
      border: 1px solid rgba(15, 23, 42, 0.1);
      border-radius: 1rem;
      box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.08);
    }
  </style>
</head>
<body>
  <!-- Centered login layout for user authentication -->
  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-5">
        <div class="auth-card bg-white p-4 p-md-5">
          <h1 class="h3 fw-bold mb-2 text-center">Login to CloudX Hub</h1>
          <p class="text-secondary text-center mb-4">Access your secure project repository.</p>

          <!-- Show server-side validation or authentication errors. -->
          <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="alert alert-danger" role="alert">
              <ul class="mb-0 ps-3">
                <% errors.forEach((error) => { %>
                  <li><%= error %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <!-- Login form fields for credential input -->
          <form action="/login" method="post" novalidate>
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="name@company.com" value="<%= formData && formData.email ? formData.email : '' %>" required />
            </div>
            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Login</button>
          </form>

          <!-- Navigation links for related authentication pages. -->
          <div class="d-flex justify-content-between mt-4">
            <a href="/" class="link-secondary">Home</a>
            <a href="/register" class="link-primary">Register</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"
  ></script>
</body>
</html>
