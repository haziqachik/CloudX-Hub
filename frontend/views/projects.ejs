<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CloudX Hub | Projects</title>


<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">


<link
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
rel="stylesheet">


<link
rel="stylesheet"
href="/css/style.css">


</head>


<body>


<!-- Navigation -->

<nav class="navbar navbar-expand-lg sticky-top">

<div class="container">


<a
class="navbar-brand"
href="/dashboard">

<i class="bi bi-cloud-fill me-2"></i>

CloudX Hub

</a>



<div>


<a
href="/dashboard"
class="btn btn-outline-primary me-2">

<i class="bi bi-speedometer2 me-1"></i>

Dashboard

</a>


<a
href="/logout"
class="btn btn-outline-danger">

<i class="bi bi-box-arrow-right me-1"></i>

Logout

</a>


</div>


</div>

</nav>






<main class="container py-5">


<!-- Header -->

<div class="mb-5">


<h1 class="fw-bold">

My Projects

</h1>


<p class="text-muted">

Create, manage and securely store your cloud project files.

</p>


</div>







<!-- Create Project -->


<div class="section-card p-4 mb-5">


<h4 class="mb-4">

<i class="bi bi-folder-plus me-2"></i>

Create New Project

</h4>




<% if(errors.length > 0){ %>


<div class="alert alert-danger">

<% errors.forEach(error => { %>

<div>

<%= error %>

</div>

<% }) %>

</div>


<% } %>





<form action="/projects" method="POST">



<div class="mb-3">


<label class="form-label">

Project Name

</label>


<input

type="text"

name="projectName"

class="form-control"

placeholder="Enter project name"

required>


</div>






<div class="mb-3">


<label class="form-label">

Description

</label>


<textarea

name="description"

class="form-control"

rows="4"

placeholder="Describe your project">

</textarea>


</div>





<button

type="submit"

class="btn btn-primary">


<i class="bi bi-plus-circle me-2"></i>

Create Project


</button>


</form>



</div>








<!-- Project List -->


<h3 class="mb-4">

<i class="bi bi-folder2-open me-2"></i>

My Projects

</h3>






<% if(projects.length === 0){ %>



<div class="section-card p-5 text-center">


<i class="bi bi-folder-x fs-1 text-muted"></i>


<h5 class="mt-3">

No projects yet

</h5>


<p class="text-muted">

Create your first CloudX Hub project.

</p>


</div>




<% } else { %>






<% projects.forEach(project => { %>




<div class="project-card p-4 mb-4">





<div class="d-flex justify-content-between align-items-start">


<div>


<h4 class="project-title">


<i class="bi bi-folder-fill me-2"></i>

<%= project.project_name %>


</h4>


<p class="project-description">

<%= project.description || "No description provided." %>

</p>


<small class="text-muted">

Created:

<%= new Date(project.created_at).toLocaleString() %>

</small>


</div>



<span class="project-badge">

Active

</span>



</div>







<hr>







<!-- Files -->


<h5>


<i class="bi bi-file-earmark-lock me-2"></i>

Uploaded Files


</h5>





<% if(project.files.length === 0){ %>


<p class="text-muted">

No files uploaded yet.

</p>




<% } else { %>




<% project.files.forEach(file => { %>




<div class="file-item">


<div>


<strong>


<i class="bi bi-file-earmark me-2"></i>


<%= file.file_name %>


</strong>


<br>


<small class="text-muted">


Uploaded:

<%= new Date(file.uploaded_at).toLocaleString() %>


</small>


</div>





<div>


<a

href="/projects/files/<%= file.id %>/download"

class="btn btn-sm btn-primary">


<i class="bi bi-download"></i>

Download


</a>






<form

action="/projects/files/<%= file.id %>/delete"

method="POST"

style="display:inline"

onsubmit="return confirm('Delete this file?');">


<button

type="submit"

class="btn btn-sm btn-danger">


<i class="bi bi-trash"></i>

Delete


</button>


</form>


</div>



</div>




<% }) %>




<% } %>









<hr>







<!-- Upload -->


<form

action="/projects/<%= project.id %>/upload"

method="POST"

enctype="multipart/form-data">





<div class="upload-box">


<i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>


<h6 class="mt-2">

Upload Project File

</h6>



<input

type="file"

name="file"

class="form-control mt-3"

required>



<button

type="submit"

class="btn btn-success mt-3">


<i class="bi bi-upload me-2"></i>

Upload File


</button>


</div>



</form>







</div>





<% }) %>



<% } %>






</main>



</body>

</html>
